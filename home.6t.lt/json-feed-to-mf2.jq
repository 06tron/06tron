._prefix_for_tag_urls as $tag_prefix | [
	"<!DOCTYPE\nhtml>",
	"<html\nclass=h-feed\nlang=en>",
	"<meta\ncharset=utf-8>",
	"<title>",
	.title,
	"</title>",
	"<link\nrel=stylesheet\nhref=./shared-style.css>",
	"<link\nrel=stylesheet\nhref=./column-style.css>",
	"<link\nrel=icon\nhref=./icons/♥.svg>",
	"<link\nrel=canonical\nhref=https://home.6t.lt/mf2.html>",
	"<meta\nname=color-scheme\ncontent='dark light'>",
	"<meta\nname=description\ncontent='",
	.description,
	"'>",
	"<meta\nname=format-detection\ncontent='telephone=no'>",
	"<meta\nname=viewport\ncontent='width=device-width'>",
	"<header\nid=shared_top>",
	"<a\nhref=./index.html>",
	"<img\nalt='Heart-shaped tromino icon.'\nsrc=./icons/♥.svg\nheight=40\nwidth=40>",
	"</a>",
	"<a\nhref=./mf2.html>[blog]</a>",
	"<a\nhref=https://tangled.org/mrichardson.tngl.sh/06tron/tree/homepage/articles>",
	"updated <time\nclass=dt-updated\ndatetime=",
	._atom_elements.updated,
	">",
	._atom_elements.updated[:10],
	"</time></a>",
	"<a\nhref=./sitemap.html>[sitemap]</a>",
	"</header><hgroup>",
	"<h1\nclass='p-name site-title'>",
	"<a\nrel=bookmark\nhref=",
	.home_page_url,
	"\nclass=u-url>",
	.title,
	"</a></h1>",
	"<p\nclass=p-summary>",
	.description,
	"</hgroup>",
	(.items | length as $len | to_entries[] | [
		"<article\nid='",
		$len - .key,
		"'\nclass=h-entry>",
		"<hgroup>",
		"<h2\nclass='entry-title p-name'>",
		"<a\nrel=bookmark\nhref=",
		.value.url,
		"\nclass=u-url>",
		.value.title,
		"</a></h2><p><small>",
		"<time\nclass=dt-published>",
		.value.date_published,
		"</time></small></hgroup>",
		"<div\nclass=e-content>",
		(.value.content_html | gsub("=(?<q>['\"])https://home.6t.lt/"; "=\(.q)./")),
		"</div><footer><p><small>",
		"<samp\nclass=u-uid>",
		.value.id,
		"</samp> | <a\nhref=https://tangled.org/mrichardson.tngl.sh/06tron/tree/homepage/articles/",
		(.value.title | .[:index(" ")]),
		".xml>updated <time\nclass=dt-updated>",
		.value.date_modified,
		"</time></a></small>",
		"<p>Tags: ",
		([.value.tags[] | [
			"<a\nrel='category tag'\nhref='",
			$tag_prefix,
			.,
			"'\nclass=p-category>",
			.,
			"</a>, "
		]] | flatten | join("")[:-2]),
		"</footer></article>"
	])
] | flatten | join("")
